DEBUG=false

# REQUIRED in production: long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Defaults: SQLite and photos in the project root (EcoProblems/ecoproblems.db, EcoProblems/uploads)
# DATABASE_URL=sqlite:///C:/path/to/ecoproblems.db
# MEDIA_DIR=C:/path/to/uploads

CORS_ORIGINS=["http://localhost:3000"]

MAX_PHOTOS_PER_POINT=10
MAX_PHOTO_SIZE_MB=10

# Reverse geocoding (OpenStreetMap Nominatim, max 1 request/second)
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=EcoGuard/0.1
